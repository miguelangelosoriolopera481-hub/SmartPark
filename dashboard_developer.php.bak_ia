<?php
session_start();
require_once 'conexion.php';
require_once 'auth_handler.php';
require_once 'csrf.php';
require_once 'helpers.php';
send_security_headers();

if (empty($_SESSION['usuario_id']) || ($_SESSION['role'] ?? '') !== 'developer') {
    header('Location: login_developer.php');
    exit;
}

// Stats globales rápidos
try {
    $stats = [
        'empresas_total' => (int)$pdo->query("SELECT COUNT(*) FROM empresas")->fetchColumn(),
        'empresas_pendientes' => (int)$pdo->query("SELECT COUNT(*) FROM empresas WHERE estado_aprobacion='pendiente'")->fetchColumn(),
        'parqueaderos' => (int)$pdo->query("SELECT COUNT(*) FROM parqueaderos")->fetchColumn(),
        'usuarios' => (int)$pdo->query("SELECT COUNT(*) FROM user")->fetchColumn(),
        'cupos' => (int)$pdo->query("SELECT COUNT(*) FROM cupos")->fetchColumn(),
        'activos' => (int)$pdo->query("SELECT COUNT(*) FROM registros_parqueo WHERE estado='activo'")->fetchColumn(),
        'registros_total' => (int)$pdo->query("SELECT COUNT(*) FROM registros_parqueo")->fetchColumn(),
        'recaudo' => (float)$pdo->query("SELECT COALESCE(SUM(total_pagar),0) FROM registros_parqueo WHERE estado_pago=1")->fetchColumn(),
    ];
} catch (\Throwable $e) {
    $stats = array_map(fn() => 0, ['empresas_total'=>0,'empresas_pendientes'=>0,'parqueaderos'=>0,'usuarios'=>0,'cupos'=>0,'activos'=>0,'registros_total'=>0,'recaudo'=>0]);
}
?>
