# SmartPark Pro - Plantilla de configuracion
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas tu .env real a Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartpark
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_URL=http://localhost/sistema2

# Genera una nueva con: php -r "echo base64_encode(random_bytes(32));"
APP_CRYPTO_KEY=CAMBIAR_ESTA_CLAVE_POR_UNA_REAL

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
