<div class="container cyber-entrance">
  <h2 style="color:var(--primary-cyan);margin-bottom:1.5rem">Dashboard Financiero</h2>

  <div class="grid-3">
    <div class="cyber-card"><h4>Total 30 dias</h4>
      <p style="font-size:2.2rem;color:var(--primary-green)">$<?= number_format($totalMes,0,',','.') ?></p></div>
    <?php foreach ($porMetodo as $m): ?>
      <div class="cyber-card"><h4><?= htmlspecialchars(strtoupper($m['metodo_pago'])) ?></h4>
        <p style="font-size:1.6rem;color:var(--primary-cyan)">$<?= number_format((float)$m['total'],0,',','.') ?></p>
        <small style="color:var(--text-muted)"><?= (int)$m['cnt'] ?> pagos</small></div>
    <?php endforeach; ?>
  </div>

  <div class="cyber-card" style="margin-top:2rem">
    <h3 style="color:var(--primary-cyan);margin-bottom:1rem">Ingresos por Dia (30 dias)</h3>
    <div class="table-wrapper"><table>
      <thead><tr><th>Fecha</th><th>Salidas</th><th>Recaudo</th></tr></thead>
      <tbody>
      <?php if (empty($porDia)): ?>
        <tr><td colspan="3" style="text-align:center;color:var(--text-muted);padding:1rem">Sin datos.</td></tr>
      <?php else: foreach ($porDia as $r): ?>
        <tr><td><?= htmlspecialchars($r['d']) ?></td><td><?= (int)$r['cnt'] ?></td>
            <td><strong style="color:var(--primary-green)">$<?= number_format((float)$r['total'],0,',','.') ?></strong></td></tr>
      <?php endforeach; endif; ?>
      </tbody></table></div>
  </div>

  <div style="margin-top:1.5rem;display:flex;gap:1rem;flex-wrap:wrap">
    <a href="exportar_finanzas.php?formato=csv" class="cyber-btn-outline">Exportar CSV/Excel</a>
