<?php
session_start();
require_once 'conexion.php';
require_once 'helpers.php';
require_once 'csrf.php';
send_security_headers();

require_role_empresa(['admin','superadmin','finanzas']);
$eid = current_empresa_id();

$stmt = $pdo->prepare("
    SELECT DATE(fecha_salida) d, SUM(total_pagar) total, COUNT(*) cnt
    FROM registros_parqueo
    WHERE empresa_id = :eid AND fecha_salida IS NOT NULL AND fecha_salida >= (NOW() - INTERVAL 30 DAY)
    GROUP BY DATE(fecha_salida) ORDER BY d DESC
");
$stmt->execute(['eid' => $eid]);
$porDia = $stmt->fetchAll();

$stmt = $pdo->prepare("
    SELECT metodo_pago, SUM(monto) total, COUNT(*) cnt
    FROM pagos WHERE empresa_id = :eid AND estado='aprobado' AND creado_en >= (NOW() - INTERVAL 30 DAY)
    GROUP BY metodo_pago
");
$stmt->execute(['eid' => $eid]);
$porMetodo = $stmt->fetchAll();

$totalMes = array_sum(array_column($porDia, 'total'));
?>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
