</head>
<body class="cyber-body">
<nav class="cyber-navbar"><div class="nav-container">
  <a href="dashboard_admin.php" class="cyber-btn-outline">Panel Admin</a>
  <span style="color:var(--text-muted)">Finanzas - Empresa #<?= (int)$eid ?></span>
  <a href="logout.php" style="color:var(--danger)">Salir</a>
